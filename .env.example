# LLM API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
HUGGINGFACE_API_KEY=hf_...

# LLM defaults
DEFAULT_LLM_PROVIDER=huggingface
DEFAULT_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ChromaDB (omit for in-memory)
CHROMA_PERSIST_DIR=./.chroma

# Observability
OTEL_SERVICE_NAME=agent-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Free-tier providers (set DEFAULT_LLM_PROVIDER=groq or gemini to use)
# Groq key: https://console.groq.com/keys  (model e.g. openai/gpt-oss-120b)
GROQ_API_KEY=gsk_...
# Gemini key: https://aistudio.google.com/apikey  (model e.g. gemini-2.0-flash)
GEMINI_API_KEY=...

# Set to hash to skip Chroma 79MB embedding model download (offline, keyword-based)
# MEMORY_EMBEDDING=hash

# MCP Studio
# JEV_MODEL_PATH=models/Jev-Style-0.8B-Decision-v3-Q4_K_M.gguf   # on-device tool picker
# STUDIO_DIR=.studio                  # where servers.json and OAuth tokens are stored
# STUDIO_CALL_TIMEOUT=60              # seconds before a tool call is abandoned
# STUDIO_PUBLIC_URL=http://127.0.0.1:8003   # OAuth redirect base (must match how you reach the API)
# STUDIO_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
